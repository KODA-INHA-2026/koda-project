{"id":"sh/v61wbmtw","kind":"textbox","position":{"left":64,"top":222,"width":698,"height":308},"text":"{\n \"format\": \"koda-document-verification/v1\",\n \"chain\": {\"chainId\": 11155111, \"contract\": \"0x...\"},\n \"proof\": {\n   \"documentId\": \"0x...\",     // 32 bytes, nonzero\n   \"documentHash\": \"0x...\",   // 32 bytes, nonzero\n   \"issuedAt\": \"1793961780\",  // decimal uint64 string\n   \"signature\": \"0x...\",      // 65 bytes\n   \"transactionHash\": \"0x...\" // 32 bytes, required\n }\n}\n// 위 주석은 설명용이며 실제 JSON에는 포함하지 않는다.","style":{"fontSize":19.51,"typeface":"Consolas","color":"#202C3C","alignment":"left"},"geometry":"rect","lineWidth":0},
