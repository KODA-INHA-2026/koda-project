{"id":"sh/32hc3u5g","kind":"textbox","position":{"left":56,"top":108,"width":1168,"height":52},"text":"Etherscan은 체인 기록을 보여주는 도구다. 문서와 기록의 관계는 우리 검증기에서 추가로 확인한다.","style":{"fontSize":21,"typeface":"Pretendard","color":"#526579","alignment":"left"},"geometry":"rect","lineWidth":0},
