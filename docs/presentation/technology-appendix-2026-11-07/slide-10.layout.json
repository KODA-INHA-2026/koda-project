{"id":"sh/3eh0r6ls","kind":"textbox","position":{"left":64,"top":222,"width":698,"height":308},"text":"B = hex(finalized.number)\nCALLDATA = \"0x01e64725\" + documentId_without_0x\n\n{\n  \"jsonrpc\": \"2.0\", \"id\": 1,\n  \"method\": \"eth_call\",\n  \"params\": [\n    { \"to\": CONTRACT, \"data\": CALLDATA },\n    B\n  ]\n}\n\nresult: ABI(bytes32 documentHash, uint64 issuedAt)","style":{"fontSize":19.51,"typeface":"Consolas","color":"#202C3C","alignment":"left"},"geometry":"rect","lineWidth":0},
